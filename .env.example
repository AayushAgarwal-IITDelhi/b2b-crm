# Google Gemini API key (optional for LLM-based portfolio extraction; falls back to deterministic keyword matching if unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database path (defaults to exhibition_lead_agent.db in the root folder)
EXHIBITION_AGENT_DB=exhibition_lead_agent.db
